        "jsCode": "const tareasActuales = $input.all().map(item => {\n  const data = item.json;\n  \n  return {\n    id: data.id || null,\n    nombre: data.property_task_name || data.name || \"Sin título\",\n    estado: data.property_estado || \"Sin estado\",\n    inicio: data.property_comienzo?.start || null,\n    fin: data.property_fin?.start || null,\n    area: data.property_area || \"General\",\n    descripcion: data.property_descripcion || \"\"\n  };\n});\n\nreturn [{\n  json: {\n    tareas_dashboard_actuales: tareasActuales\n  }\n}];"
