    {
      "parameters": {
        "jsCode": "const inputs = $input.all();\n\nlet allTasks = [];\n\nfor (const item of inputs) {\n  let response = item.json;\n\n  // Extraemos el contenido\n  let content = response.output ?? response.text ?? response;\n\n  // Si viene como string, limpiamos Markdown y parseamos JSON\n  if (typeof content === 'string') {\n\n    // Eliminamos los bloques Markdown ```json y ```\n    content = content\n      .replace(/```json\\s*/gi, '')\n      .replace(/```\\s*/g, '')\n      .trim();\n\n    content = JSON.parse(content);\n  }\n\n  // Si es un array, agregamos todas las tareas\n  if (Array.isArray(content)) {\n    allTasks.push(...content);\n  } else {\n    allTasks.push(content);\n  }\n}\n\n// Convertimos cada tarea en un item independiente de n8n\nreturn allTasks.map(task => ({\n  json: task\n}));"
      },
