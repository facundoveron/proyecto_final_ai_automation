    {
      "parameters": {
        "jsCode": "return items\n  .filter(item => {\n    const tarea = item.json;\n\n    return Object.values(tarea).every(valor => {\n      // Rechazar null o undefined\n      if (valor === null || valor === undefined) return false;\n\n      // Rechazar strings vacíos\n      if (typeof valor === \"string\" && valor.trim() === \"\") return false;\n\n      // Rechazar arrays vacíos\n      if (Array.isArray(valor) && valor.length === 0) return false;\n\n      return true;\n    });\n  })\n  .map(item => {\n    const tarea = item.json;\n\n    // Fecha actual (sin hora)\n    const hoy = new Date();\n    hoy.setHours(0, 0, 0, 0);\n\n    // Fecha de finalización\n    const fechaFin = new Date(tarea.fin + \"T00:00:00\");\n\n    // Diferencia en días\n    const diasRestantes = Math.ceil(\n      (fechaFin - hoy) / (1000 * 60 * 60 * 24)\n    );\n\n    return {\n      json: {\n        ...tarea,\n        dias_restantes: diasRestantes,\n        vencida: diasRestantes < 0,\n        estado_fecha: diasRestantes < 0\n          ? \"Vencida\"\n          : diasRestantes === 0\n            ? \"Vence hoy\"\n            : \"En plazo\"\n      }\n    };\n  });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
